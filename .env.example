# MAX bot token, issued by hackathon organizers / MAX bot cabinet
MAX_BOT_TOKEN=

# Base URL of the MAX Bot API (rarely needs to change; botapi.max.ru is
# being retired in favor of this domain)
MAX_API_URL=https://platform-api.max.ru

# Used only by `npm run set-webhook` (bot/set-webhook.js) to register the
# webhook — MAX has no UI field for this, it's done via a one-off API call.
# On Render this can be left empty; RENDER_EXTERNAL_URL is set automatically.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Public URL of the deployed mini-app (GitHub Pages / Vercel), used for the
# "open mini-app" button in bot messages
MINIAPP_URL=https://example.github.io/max-leisure-hackathon/

# "link" (default): the button opens MINIAPP_URL as a plain external link —
# works right away, no setup needed. "native": use a real open_app button —
# only works after the mini-app URL is registered against this bot in the
# MAX business cabinet (business.max.ru/self → организация → бот →
# "Мини-приложения").
MINIAPP_MODE=link

# LLM-powered query parsing and personalized blurbs. Optional: the bot
# falls back to rule-based filtering if the chosen provider has no key set
# or the call fails.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Alternative provider — set LLM_PROVIDER=openrouter to use this instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Port the bot server listens on inside the container
PORT=3000

# Default city used when the platform doesn't supply one yet
DEFAULT_CITY=Казань
